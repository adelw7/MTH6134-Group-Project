> # Set Away as the reference category
> matches$home_away <- factor(
+   matches$home_away,
+   levels = c("Away", "Home")
+ )

> # Compare average goals scored
> aggregate(goals_scored ~ home_away,
+           data = matches, FUN = mean)
  home_away goals_scored
1      Away    0.8695652
2      Home    1.7391304

> # Fit the Poisson regression model
> model1 <- glm(
+   goals_scored ~ home_away + opponent_rank,
+   family = poisson(link = "log"),
+   data = matches
+ )

> # View the model results
> summary(model1)

Call:
glm(formula = goals_scored ~ home_away + opponent_rank, family = poisson(link = "log"), 
    data = matches)

