> # Calculate rate ratios
> exp(coef(model1))
  (Intercept) home_awayHome opponent_rank 
    0.4070565     2.0000000     1.0558519 

> # Check goodness of fit
> deviance(model1)
[1] 49.7845

> df.residual(model1)
[1] 43

> # Check for overdispersion
> sum(residuals(model1, type = "pearson")^2) /
+   df.residual(model1)
[1] 0.9904079

> # Models with fewer explanatory variables
> model_home <- glm(
+   goals_scored ~ home_away,
+   family = poisson,
+   data = matches
+ )

> model_rank <- glm(
+   goals_scored ~ opponent_rank,
+   family = poisson,
+   data = matches
+ )

> # Likelihood-ratio tests
> anova(model_home, model1, test = "Chisq")
